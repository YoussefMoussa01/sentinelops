# Database
DATABASE_URL=postgresql://sentinelops:sentinelops_pass@localhost:5432/sentinelops_db

# JWT
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=3600
JWT_REFRESH_EXPIRATION_SECONDS=604800
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# API
API_V1_PREFIX=/api/v1
API_TITLE=SentinelOps API
API_VERSION=0.1.0

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
AI_MODEL=openai/gpt-4
AI_FALLBACK_MODELS=
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=900
AI_MAX_INPUT_CHARS=1600
AI_MAX_CONTEXT_CHARS=600
AI_TIMEOUT_SECONDS=30
AI_RETRY_ATTEMPTS=2
AI_RETRY_BACKOFF_SECONDS=2
AI_SITE_URL=http://localhost:5173
AI_SITE_NAME=SentinelOps
AI_REASONING_ENABLED=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/sentinelops.log

# Security
ALLOWED_HOSTS=localhost,127.0.0.1
DEBUG=False

# Environment
ENVIRONMENT=development

# Optional first super-admin bootstrap (leave empty to disable)
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
